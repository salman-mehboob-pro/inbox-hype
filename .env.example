# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Used by the sending tick and to read encrypted inbox passwords.
SUPABASE_SECRET_KEY=sb_secret_...

# Public URL of this app (used for tracking + unsubscribe links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32-byte key, base64. Encrypts inbox passwords (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Protects /api/cron/tick. Any long random string.
CRON_SECRET=

# Local only: run the whole sending flow without sending any email (ignored in production).
# TICK_DRY_RUN=true
